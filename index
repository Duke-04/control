<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sistema de Control PID - Dos Tanques</title>
<script src="https://unpkg.com/mqtt/dist/mqtt.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    /* Paleta exportada del código en Python */
    --bg: #0D1117;
    --panel: #161B22;
    --panel-border: #30363D;
    --accent-blue: #58A6FF;
    --accent-green: #3FB950;
    --accent-red: #F85149;
    --accent-orange: #D29922;
    --text-primary: #E6EDF3;
    --text-secondary: #8B949E;
    --btn-active: #238636;
    --btn-inactive: #21262D;
    --grid: rgba(88, 166, 255, 0.05);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    font-family: 'Rajdhani', sans-serif;
    color: var(--text-primary);
    min-height: 100vh;
    padding: 20px;
    background-image: 
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    background: var(--panel);
    padding: 15px 25px;
    border-radius: 8px;
    border: 1px solid var(--panel-border);
  }

  .title h1 {
    color: var(--accent-blue);
    font-size: 24px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .title p {
    color: var(--text-secondary);
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px;
  }

  /* Conexión MQTT */
  .mqtt-status {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Share Tech Mono', monospace;
    font-size: 14px;
    padding: 8px 16px;
    border-radius: 20px;
    border: 1px solid var(--panel-border);
  }
  .mqtt-status.disconnected { color: var(--accent-red); border-color: var(--accent-red); }
  .mqtt-status.connected { color: var(--accent-green); border-color: var(--accent-green); }

  .dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  /* Controles (Botones y Setpoint) */
  .controls-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .panel {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    padding: 20px;
  }

  .panel-title {
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px;
    color: var(--text-secondary);
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 1px solid var(--panel-border);
    padding-bottom: 5px;
  }

  .btn-group {
    display: flex;
    gap: 10px;
  }

  .btn {
    flex: 1;
    background: var(--btn-inactive);
    color: var(--text-primary);
    border: 1px solid var(--panel-border);
    padding: 10px;
    border-radius: 6px;
    cursor: pointer;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    transition: all 0.3s;
  }

  .btn:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
  .btn.active { background: var(--btn-active); border-color: var(--accent-green); }

  .slider-container {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 15px;
  }

  .slider-container input[type="range"] {
    flex: 1;
    accent-color: var(--accent-blue);
  }

  .slider-value {
    font-family: 'Share Tech Mono', monospace;
    color: var(--accent-blue);
    font-size: 18px;
    min-width: 60px;
  }

  /* Cuadrícula de Gráficas */
  .plots-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .plot-panel {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .canvas-container {
    height: 250px;
    width: 100%;
    position: relative;
    padding: 10px;
  }

  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Planta / Tanques visuales */
  .tanks-display {
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
    height: 150px;
    margin-top: 20px;
  }

  .tank {
    width: 80px;
    height: 120px;
    border: 2px solid var(--panel-border);
    border-radius: 4px;
    position: relative;
    background: #0D1117;
    overflow: hidden;
  }

  .water-level {
    position: absolute;
    bottom: 0;
    width: 100%;
    background: linear-gradient(0deg, #145A8A, #3A96FF);
    transition: height 0.1s linear;
  }

  .tank-label {
    text-align: center;
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px;
    margin-top: 10px;
    color: var(--text-secondary);
  }

</style>
</head>
<body>

  <div class="header">
    <div class="title">
      <h1>Control PID - Planta Dos Tanques</h1>
      <p>INTERFAZ DE MONITOREO Y CONTROL VÍA MQTT</p>
    </div>
    <div id="mqttStatus" class="mqtt-status disconnected">
      <div class="dot"></div>
      <span id="statusText">Desconectado</span>
    </div>
  </div>

  <div class="controls-container">
    <div class="panel">
      <div class="panel-title">Generador de Señal (Referencia)</div>
      <div class="btn-group">
        <button class="btn active" id="btnSquare" onclick="setSignal('square')">Cuadrada</button>
        <button class="btn" id="btnRamp" onclick="setSignal('ramp')">Rampa</button>
        <button class="btn" id="btnSine" onclick="setSignal('sine')">Senoidal</button>
      </div>
      <div class="slider-container">
        <span class="panel-title" style="border:none; margin:0;">Setpoint (cm)</span>
        <input type="range" id="spSlider" min="10" max="80" value="40" oninput="updateSetpoint()">
        <span class="slider-value" id="spVal">4.00</span>
      </div>
    </div>

    <div class="panel">
      <div class="panel-title">Estado de la Planta</div>
      <div class="tanks-display">
        <div>
          <div class="tank"><div class="water-level" id="waterT1" style="height: 0%;"></div></div>
          <div class="tank-label" id="lblT1">T1: 0.00 cm</div>
        </div>
        <div>
          <div class="tank"><div class="water-level" id="waterT2" style="height: 0%;"></div></div>
          <div class="tank-label" id="lblT2">T2: 0.00 cm</div>
        </div>
      </div>
    </div>
  </div>

  <div class="plots-grid">
    <div class="plot-panel">
      <div class="panel-title" style="padding:10px 15px; margin:0; border-bottom:1px solid #30363D;">Nivel (yk) vs Referencia (rk)</div>
      <div class="canvas-container"><canvas id="canvasPos"></canvas></div>
    </div>
    <div class="plot-panel">
      <div class="panel-title" style="padding:10px 15px; margin:0; border-bottom:1px solid #30363D;">Error de Control (ek)</div>
      <div class="canvas-container"><canvas id="canvasErr"></canvas></div>
    </div>
    <div class="plot-panel" style="grid-column: span 2;">
      <div class="panel-title" style="padding:10px 15px; margin:0; border-bottom:1px solid #30363D;">Esfuerzo de Control (uk)</div>
      <div class="canvas-container" style="height: 180px;"><canvas id="canvasCtrl"></canvas></div>
    </div>
  </div>

<script>
// =========================================================
// 1. CONFIGURACIÓN MQTT
// =========================================================
const brokerUrl = "wss://test.mosquitto.org:8081/mqtt"; // O el tuyo (broker WebSocket)
const topicData = "planta/tanques/datos";
const topicCmd  = "planta/tanques/cmd";

const client = mqtt.connect(brokerUrl);

client.on("connect", () => {
  document.getElementById("mqttStatus").className = "mqtt-status connected";
  document.getElementById("statusText").innerText = "Conectado a MQTT";
  client.subscribe(topicData);
});

client.on("error", (err) => {
  console.error("Error MQTT:", err);
});

client.on("close", () => {
  document.getElementById("mqttStatus").className = "mqtt-status disconnected";
  document.getElementById("statusText").innerText = "Desconectado";
});

// =========================================================
// 2. RECEPCIÓN DE DATOS (rk, yk, ek, uk, h1, h2)
// =========================================================
client.on("message", (topic, message) => {
  if (topic === topicData) {
    // Se espera que el mensaje llegue como JSON: {"rk":4.0, "yk":3.5, "ek":0.5, "uk":120, "h1":3.5, "h2":2.0}
    // O si llega en CSV como el Python (ej. "4.0,3.5,0.5,120,3.5,2.0"), puedes cambiar este parseo.
    try {
      const data = JSON.parse(message.toString());
      pushData(data.rk, data.yk, data.ek, data.uk, data.h1, data.h2);
    } catch (e) {
      // Si el ESP32 manda CSV en vez de JSON
      const parts = message.toString().split(',');
      if(parts.length >= 6){
        pushData(
          parseFloat(parts[0]), parseFloat(parts[1]), parseFloat(parts[2]), 
          parseFloat(parts[3]), parseFloat(parts[4]), parseFloat(parts[5])
        );
      }
    }
  }
});

// =========================================================
// 3. ENVÍO DE COMANDOS (BOTONES Y SLIDER)
// =========================================================
function setSignal(type) {
  // UI Update
  document.querySelectorAll('.btn').forEach(b => b.classList.remove('active'));
  if(type === 'square') document.getElementById('btnSquare').classList.add('active');
  if(type === 'ramp') document.getElementById('btnRamp').classList.add('active');
  if(type === 'sine') document.getElementById('btnSine').classList.add('active');
  
  // MQTT Update
  const payload = JSON.stringify({ command: "set_signal", value: type });
  client.publish(topicCmd, payload);
}

function updateSetpoint() {
  const val = (document.getElementById('spSlider').value / 10).toFixed(2);
  document.getElementById('spVal').innerText = val;
  
  // MQTT Update
  const payload = JSON.stringify({ command: "set_setpoint", value: parseFloat(val) });
  client.publish(topicCmd, payload);
}

// =========================================================
// 4. MOTOR DE GRÁFICAS (CANVAS PLATFORM)
// =========================================================
const MAX_POINTS = 300;
const buffers = {
  rk: new Array(MAX_POINTS).fill(0), // Referencia
  yk: new Array(MAX_POINTS).fill(0), // Posición (Nivel T1/T2)
  ek: new Array(MAX_POINTS).fill(0), // Error
  uk: new Array(MAX_POINTS).fill(0)  // Control
};

const canvases = {
  pos: document.getElementById('canvasPos'),
  err: document.getElementById('canvasErr'),
  ctrl: document.getElementById('canvasCtrl')
};

// Evita ver los bordes borrosos en las gráficas
function resizeCanvases() {
  Object.values(canvases).forEach(canvas => {
    const parent = canvas.parentElement;
    canvas.width = parent.clientWidth;
    canvas.height = parent.clientHeight;
  });
}
window.addEventListener('resize', resizeCanvases);
resizeCanvases();

function pushData(rk, yk, ek, uk, h1, h2) {
  // Rotar buffers
  buffers.rk.push(rk); buffers.rk.shift();
  buffers.yk.push(yk); buffers.yk.shift();
  buffers.ek.push(ek); buffers.ek.shift();
  buffers.uk.push(uk); buffers.uk.shift();

  // Actualizar animación de tanques (0 a 8 cm maximo)
  const p1 = Math.min(100, Math.max(0, (h1 / 8.0) * 100));
  const p2 = Math.min(100, Math.max(0, (h2 / 8.0) * 100));
  document.getElementById('waterT1').style.height = p1 + '%';
  document.getElementById('waterT2').style.height = p2 + '%';
  document.getElementById('lblT1').innerText = `T1: ${h1.toFixed(2)} cm`;
  document.getElementById('lblT2').innerText = `T2: ${h2.toFixed(2)} cm`;
}

// Función genérica para dibujar lineas
function drawPlot(canvas, buffersArr, colors, minVal, maxVal, refBuf = null) {
  const ctx = canvas.getContext('2d');
  const W = canvas.width;
  const H = canvas.height;
  
  ctx.clearRect(0, 0, W, H);
  
  // Dibujar grilla
  ctx.strokeStyle = 'rgba(88, 166, 255, 0.1)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  for(let i=0; i<4; i++) {
    const y = (i/4)*H;
    ctx.moveTo(0, y); ctx.lineTo(W, y);
  }
  ctx.stroke();

  // Función interna para trazar línea
  const trace = (data, color, isRef) => {
    ctx.beginPath();
    ctx.strokeStyle = color;
    ctx.lineWidth = isRef ? 1.5 : 2;
    if(isRef) ctx.setLineDash([5, 5]); else ctx.setLineDash([]);
    
    for (let i = 0; i < MAX_POINTS; i++) {
      const x = (i / (MAX_POINTS - 1)) * W;
      const val = Math.max(minVal, Math.min(maxVal, data[i]));
      const y = H - ((val - minVal) / (maxVal - minVal)) * H;
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();
  };

  // Traza la referencia si existe
  if(refBuf) trace(refBuf, 'rgba(230, 237, 243, 0.6)', true);
  
  // Traza las líneas de datos
  buffersArr.forEach((buf, idx) => {
    trace(buf, colors[idx], false);
  });
}

// Loop de renderizado (60 FPS)
function render() {
  // rk y yk entre 0 y 8 cm
  drawPlot(canvases.pos, [buffers.yk], ['#58A6FF'], 0, 8, buffers.rk);
  // ek (error) entre -5 y 5
  drawPlot(canvases.err, [buffers.ek], ['#F85149'], -5, 5);
  // uk (PWM/Esfuerzo) entre 0 y 255
  drawPlot(canvases.ctrl, [buffers.uk], ['#3FB950'], 0, 255);
  
  requestAnimationFrame(render);
}
render();

// =========================================================
// MODO SIMULACIÓN (OPCIONAL: Borrar si solo usas ESP32)
// Genera datos aleatorios si no hay MQTT para que veas que funciona
// =========================================================
setInterval(() => {
  if (document.getElementById("mqttStatus").classList.contains("disconnected")) {
    const rk = document.getElementById('spSlider').value / 10;
    const yk = rk * 0.9 + (Math.random() * 0.2 - 0.1); 
    const ek = rk - yk;
    const uk = 120 + (ek * 10);
    const h1 = yk;
    const h2 = yk * 0.8; // Tanque 2 con menos nivel
    pushData(rk, yk, ek, uk, h1, h2);
  }
}, 100);

</script>
</body>
</html>
